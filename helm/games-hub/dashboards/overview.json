    {
      "id": 18,
      "type": "table",
      "title": "Small games: rounds",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "games-db"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "games-db"
          },
          "rawSql": "SELECT game AS \"Game\", coalesce(props->>'mode', '') AS \"Mode\",\n  count(*) FILTER (WHERE name = 'game_started') AS \"Started\",\n  count(*) FILTER (WHERE name = 'game_ended' AND props->>'result' IN ('won', 'perfect')) AS \"Won\",\n  count(*) FILTER (WHERE name = 'game_ended' AND props->>'result' = 'lost') AS \"Lost\",\n  round(avg((props->>'length_s')::numeric) FILTER (WHERE name = 'game_ended'), 0) AS \"Avg seconds\",\n  max((props->>'level')::int) AS \"Highest level\"\nFROM events WHERE name IN ('game_started', 'game_ended') AND $__timeFilter(at) AND ('ALL' IN (${platform:sqlstring}) OR platform IN (${platform:sqlstring}))\nGROUP BY 1, 2 ORDER BY 1, 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
