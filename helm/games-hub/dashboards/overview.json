    {
      "id": 15,
      "type": "table",
      "title": "Games played",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "games-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "games-db"
          },
          "rawSql": "SELECT game AS \"Game\",\n  count(DISTINCT install_id) AS \"Players\",\n  count(DISTINCT session_id) AS \"Sessions\",\n  round(sum(mins)::numeric / nullif(count(DISTINCT session_id), 0), 1) AS \"Minutes per session\"\nFROM (\n  SELECT game, install_id, session_id, extract(epoch FROM max(at) - min(at)) / 60 AS mins\n  FROM events WHERE $__timeFilter(at) AND ('ALL' IN (${platform:sqlstring}) OR platform IN (${platform:sqlstring})) AND game <> 'hub'\n  GROUP BY game, install_id, session_id\n) s\nGROUP BY game ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
