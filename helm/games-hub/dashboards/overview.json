    {
      "id": 4,
      "type": "stat",
      "title": "Median session",
      "description": "First to last event of a session. Heartbeats every 5 minutes while a page is on screen.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "games-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "games-db"
          },
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY mins) AS \"Minutes\"\nFROM (SELECT extract(epoch FROM max(at) - min(at)) / 60 AS mins FROM events WHERE $__timeFilter(at) AND ('ALL' IN (${platform:sqlstring}) OR platform IN (${platform:sqlstring})) GROUP BY session_id) s",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Players per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "games-db"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "games-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(at, '1d'), count(DISTINCT install_id) AS \"Players\", count(DISTINCT session_id) AS \"Sessions\"\nFROM events WHERE $__timeFilter(at) AND ('ALL' IN (${platform:sqlstring}) OR platform IN (${platform:sqlstring}))\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
