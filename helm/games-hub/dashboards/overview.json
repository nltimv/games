  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Players",
      "description": "Devices or browsers with any event in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "games-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "games-db"
          },
          "rawSql": "SELECT count(DISTINCT install_id) AS \"Players\" FROM events WHERE $__timeFilter(at) AND ('ALL' IN (${platform:sqlstring}) OR platform IN (${platform:sqlstring}))",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
