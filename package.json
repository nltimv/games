    "check": "npm run lint && npm test",
    "balance": "node test/balance/driftworks.mjs",
    "balance:fleets": "node test/balance/fleets.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
