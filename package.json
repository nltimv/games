{
  "name": "games-hub",
  "version": "0.0.0-dev",
  "description": "A web application hub for random browser-based games",
  "private": true,
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
